# Podcast Index API — get keys at https://api.podcastindex.org/
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Spark rail uses @buildonspark/spark-sdk — no API key required (the SDK
# talks directly to Spark's signing operators). Self-custodial; seed lives
# NIP-44-encrypted on the user's Nostr relays.

# Optional: app identity for Podcast Index User-Agent
APP_NAME=boostmebitch

# Optional: the site's own Nostr identity (server-only — never NEXT_PUBLIC).
# Lets a signed-OUT user still post their boost note to Nostr, signed by the
# app's key via /api/nostr/site-sign. nsec or 32-byte hex. Absent = feature off
# (the "Share on Nostr" checkbox still shows, the note just isn't posted).
SITE_NOSTR_SK=

# Optional: "Continue with Google" onboarding for users with no Nostr key.
# Public by design — an OAuth web client ID is not a secret; the authorized
# JavaScript origins configured on the client are what protect it. Absent =
# the Google button doesn't render at all.
#
# Google Cloud setup: Web OAuth client with origins for the deployed domain
# and http://localhost:3000, Drive API enabled (a fresh project 403s on the
# first Drive call until you do), and BOTH `openid` and `drive.appdata` on the
# consent screen — openid is what makes the userinfo endpoint return `sub`, so
# omitting it fails AFTER consent rather than during it.
#
# drive.appdata is a NON-sensitive scope, so this needs only brand
# verification — no demo video, no third-party security assessment. The
# "unverified app" screen and the 100-user cap come from the consent screen
# sitting in Testing; publishing to In production is what clears them.
#
# Google never sees the Nostr key: it's generated locally, encrypted under a
# PIN-derived key (Argon2id, 6-8 digit PIN -> NIP-44), and only the ciphertext
# is stored in the user's own Drive appdata folder.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# BoostBox metadata service (https://github.com/ChadFarrow/boostbox)
# Used on the LNURL leg of boosts to ship the boostagram out-of-band via the
# LUD-21 comment field. The default URL points at tardbox.com; the API key
# below is the public reference key — replace it with the key for whatever
# BoostBox instance you're hitting (tardbox.com runs its own).
BOOSTBOX_URL=https://tardbox.com
BOOSTBOX_API_KEY=v4v4me

# Optional: the Android app (Trusted Web Activity) published on Zapstore.
# Together these two are what /.well-known/assetlinks.json serves, which is
# what tells Chrome the app may represent this origin — without it the app
# opens with a browser URL bar. Absent = no Android app is authorized here,
# which is the correct answer for any deploy that isn't the real one (a
# preview deployment must NOT vouch for the production package).
#
# ANDROID_CERT_SHA256 is the SHA-256 fingerprint of the APK signing
# certificate: `keytool -list -v -keystore <file> -alias <alias>`, or bare
# lowercase hex from apksigner — either spelling is accepted. Comma-separate
# to carry two during a key rotation; the build already on people's phones is
# signed by the outgoing key, so both must be live at once. See docs/android.md.
ANDROID_PACKAGE_ID=com.boostmebitch
ANDROID_CERT_SHA256=
